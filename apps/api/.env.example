# Server
NODE_ENV=production
PORT=4000

# Database  (Railway PostgreSQL / Neon / Supabase)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Redis  (Railway Redis / Upstash — optional but recommended)
REDIS_URL="redis://default:password@host:6379"

# JWT — generate strong secrets with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace_with_a_random_64_char_secret
JWT_REFRESH_SECRET=replace_with_a_different_random_64_char_secret

# Shared secret for internal Next.js → API calls (e.g. token refresh)
# Must match INTERNAL_SECRET in the web app's env.
# Generate with: openssl rand -hex 32
INTERNAL_SECRET=replace_with_a_random_64_char_hex_secret

# Frontend URL (your deployment URL)
CLIENT_ORIGIN=http://localhost:3000

# Additional allowed CORS origins, comma-separated (optional)
# ADDITIONAL_ORIGINS="https://custom-domain.com"

# EmailJS (optional - emails are skipped if not configured)
EMAILJS_SERVICE_ID=service_xxxxxxx
EMAILJS_TEMPLATE_ID=template_xxxxxxx
EMAILJS_PUBLIC_KEY=your_public_key
EMAILJS_PRIVATE_KEY=your_private_key

# Web Push (VAPID) — generate with: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=replace_with_your_vapid_public_key
VAPID_PRIVATE_KEY=replace_with_your_vapid_private_key
VAPID_SUBJECT=mailto:support@your-domain.com

# Billing provider: "mock" | "stripe" | "paystack" (defaults to "mock")
# BILLING_PROVIDER=paystack

# Set to "true" to enable the marketing demo sign-in (POST /auth/demo-credentials)
# Must be paired with a seeded demo account (npm run db:seed).
DEMO_MODE=false

# Paystack (https://dashboard.paystack.com/#/settings/developers)
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Used to verify webhook signatures (from Settings → Webhooks → endpoint secret)
PAYSTACK_WEBHOOK_SECRET=replace_with_your_paystack_webhook_secret

# Stripe (https://dashboard.stripe.com/apikeys) — used when BILLING_PROVIDER=stripe
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# STRIPE_PRICE_PRO_MONTHLY=price_xxx
# STRIPE_PRICE_PRO_ANNUAL=price_xxx
# STRIPE_PRICE_CUSTOM_MONTHLY=price_xxx
# STRIPE_PRICE_CUSTOM_ANNUAL=price_xxx
# STRIPE_PRICE_ADDON_<NAME>_MONTHLY=price_xxx
# STRIPE_PRICE_ADDON_<NAME>_ANNUAL=price_xxx